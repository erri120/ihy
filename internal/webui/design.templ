// The Dendera component catalog: the live design of record for the
// web UI (internal/webui/DESIGN.md). Specimen content is generic;
// page designs carry the real data. In dev mode every page hot-
// reloads static assets over SSE and full-reloads when the dev
// server restarts (make dev-ui); see layout.templ.
package webui

templ DesignPage(t *T) {
	@Layout(t, t.Msg("DesignSystem")) {
		<style>
			.d-page { max-width: 860px; margin: 0 auto; padding: var(--space-6) var(--space-4) 96px; }
			.d-head { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap; }
			.d-title { font-family: var(--font-serif); font-size: var(--text-display); font-weight: 600; letter-spacing: var(--track-display); }
			.d-sub { color: var(--muted); font-size: var(--text-body); margin-top: var(--space-1); max-width: 52ch; }
			.d-headtools { display: flex; flex-direction: column; gap: var(--space-2); align-items: flex-end; }
			.d-switcher { display: flex; gap: 2px; background: var(--surface); border: 1px solid var(--chip-hair); border-radius: var(--radius-pill); padding: 2px; }
			.d-switcher label { position: relative; cursor: pointer; }
			.d-switcher input { position: absolute; opacity: 0; pointer-events: none; }
			.d-switcher span { display: inline-block; padding: 5px 14px; border-radius: var(--radius-pill); font-size: 12px; font-weight: 500; color: var(--muted); }
			.d-switcher input:checked + span { background: var(--accent); color: var(--accent-ink); }
			.d-badge { font-family: var(--font-mono); font-size: var(--text-label); text-transform: uppercase; letter-spacing: var(--track-label); color: var(--muted); border: 1px solid var(--chip-hair); border-radius: var(--radius-pill); padding: 4px 10px; }
			.d-section { margin-top: var(--space-6); }
			.d-section > h2 { font-family: var(--font-serif); font-size: var(--text-title); font-weight: 600; letter-spacing: var(--track-title); }
			.d-note { font-family: var(--font-mono); font-size: var(--text-meta); color: var(--muted); margin-top: 2px; }
			.d-spec { display: grid; gap: var(--space-3); margin-top: var(--space-4); }
			.d-row { display: flex; align-items: center; gap: var(--space-4); padding: var(--space-3) var(--space-4); background: var(--surface); border-radius: var(--radius-tile); flex-wrap: wrap; }
			.d-label { font-family: var(--font-mono); font-size: var(--text-label); text-transform: uppercase; letter-spacing: var(--track-label); color: var(--muted); min-width: 170px; }
			.d-icon-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: var(--space-3); margin-top: var(--space-4); }
			.d-icon-cell { display: flex; flex-direction: column; align-items: center; gap: var(--space-2); padding: var(--space-3); background: var(--surface); border-radius: var(--radius-tile); }
			.d-icon-cell .icon { color: var(--text); }
			.d-icon-cell .d-label { min-width: 0; }
		</style>
		<div class="d-page">
			<header class="d-head">
				<div>
					<h1 class="d-title">Dendera</h1>
					<p class="d-sub">{ t.Msg("DesignTagline") }</p>
				</div>
				<div class="d-headtools">
					<div class="d-switcher" role="radiogroup" aria-label={ t.Msg("Theme") }>
						<label><input type="radio" name="d-theme" value="lapis" checked/><span>Lapis</span></label>
						<label><input type="radio" name="d-theme" value="silt"/><span>Silt</span></label>
						<label><input type="radio" name="d-theme" value="papyrus"/><span>Papyrus</span></label>
					</div>
					if t.Dev {
						<span class="d-badge">{ t.Msg("DevHotReload") }</span>
					}
				</div>
			</header>
			<section class="d-section">
				<h2>{ t.Msg("DesignType") }</h2>
				<p class="d-note">--text-display, --text-title, --text-reading, --text-body, --text-row, --text-caption, --text-meta, --text-label</p>
				<div class="d-spec">
					<div class="d-row"><span class="d-label">--text-display</span><span style="font-family: var(--font-serif); font-size: var(--text-display); font-weight: 600; letter-spacing: var(--track-display);">Album title · 岡部啓一</span></div>
					<div class="d-row"><span class="d-label">--text-title</span><span style="font-family: var(--font-serif); font-size: var(--text-title); font-weight: 600; letter-spacing: var(--track-title);">Entity name · 初音ミク</span></div>
					<div class="d-row"><span class="d-label">--text-reading</span><span style="font-size: var(--text-reading);">Longform reading text carries the quiet voice of the sans.</span></div>
					<div class="d-row"><span class="d-label">--text-body</span><span style="font-size: var(--text-body);">UI body text: the minimum size for UI copy.</span></div>
					<div class="d-row"><span class="d-label">--text-row</span><span style="font-size: var(--text-row); font-weight: 500;">Track row title</span></div>
					<div class="d-row"><span class="d-label">--text-caption</span><span style="font-size: var(--text-caption); color: var(--muted);">Role line · caption</span></div>
					<div class="d-row"><span class="d-label">--text-meta</span><span style="font-family: var(--font-mono); font-size: var(--text-meta); color: var(--muted);">2017 · Album · 36 recordings · 5:44</span></div>
					<div class="d-row"><span class="d-label">--text-label</span><span style="font-family: var(--font-mono); font-size: var(--text-label); text-transform: uppercase; letter-spacing: var(--track-label); color: var(--muted);">Section kicker</span></div>
				</div>
			</section>
			<section class="d-section">
				<h2>{ t.Msg("DesignButtons") }</h2>
				<p class="d-note">.btn, .btn-ghost, .btn-danger, .btn-icon (+ .is-active), .btn-play, [disabled]</p>
				<div class="d-spec">
					<div class="d-row">
						<span class="d-label">.btn / .btn-ghost / .btn-danger</span>
						<button class="btn" type="button">Play</button>
						<button class="btn btn-ghost" type="button">Add to queue</button>
						<button class="btn btn-danger" type="button">Remove</button>
						<button class="btn" type="button" disabled>Queued</button>
					</div>
					<div class="d-row">
						<span class="d-label">.btn-icon / .is-active / .btn-play</span>
						<button class="btn-icon" type="button" aria-label="Favorite">@Icon("heart")</button>
						<button class="btn-icon is-active" type="button" aria-label="Favorited">@Icon("heart-filled")</button>
						<button class="btn-icon btn-play" type="button" aria-label="Play" style="background: var(--accent); color: var(--accent-ink);">@Icon("play")</button>
					</div>
				</div>
			</section>
			<section class="d-section">
				<h2>{ t.Msg("DesignInputs") }</h2>
				<p class="d-note">.search, .field + .input (+ aria-invalid, .field-error)</p>
				<div class="d-spec">
					<div class="d-row">
						<span class="d-label">.search</span>
						<div class="search">
							@Icon("search")
							<input type="search" placeholder={ t.Msg("SearchPlaceholder") }/>
						</div>
					</div>
					<div class="d-row">
						<span class="d-label">.field</span>
						<div class="field" style="flex: 1; max-width: 320px;">
							<label class="field-label" for="d-input">Field label</label>
							<input class="input" id="d-input" placeholder="Placeholder"/>
						</div>
						<div class="field" style="flex: 1; max-width: 320px;">
							<label class="field-label" for="d-input-bad">Field label</label>
							<input class="input" id="d-input-bad" value="invalid input" aria-invalid="true"/>
							<span class="field-error">Validation message.</span>
						</div>
					</div>
				</div>
			</section>
			<section class="d-section">
				<h2>{ t.Msg("DesignTabs") }</h2>
				<p class="d-note">.tabs + .tab (+ .is-active)</p>
				<div class="d-spec">
					<div class="d-row" style="display: block;">
						<nav class="tabs" style="border-bottom: none;">
							<button class="tab is-active" type="button">Tab 1</button>
							<button class="tab" type="button">Tab 2</button>
							<button class="tab" type="button">Tab 3</button>
						</nav>
					</div>
				</div>
			</section>
			<section class="d-section">
				<h2>{ t.Msg("DesignCovers") }</h2>
				<p class="d-note">.cover-s/m/l/xl, .cover-empty; artwork pages pass real image sources</p>
				<div class="d-spec">
					<div class="d-row">
						<span class="d-label">sizes + placeholder</span>
						@Cover("", "No artwork", "cover-s")
						@Cover("", "No artwork", "cover-m")
						@Cover("", "No artwork", "cover-l")
						@Cover("", "No artwork", "cover-xl")
					</div>
					<div class="d-row">
						<span class="d-label">.album-grid + .album-card</span>
						<div class="album-grid" style="flex: 1;">
							<div class="album-card">
								<div class="cover cover-empty"></div>
								<div class="ac-title">Album title</div>
								<div class="ac-artist">Artist name</div>
								<div class="ac-meta">2017 · Album</div>
								<a class="ac-link" href="#" aria-label="Open album"></a>
								<button class="btn-icon btn-play ac-play" type="button" aria-label="Play album" style="background: var(--accent); color: var(--accent-ink);">@Icon("play")</button>
							</div>
							<div class="album-card">
								<div class="cover cover-empty"></div>
								<div class="ac-title">Album title</div>
								<div class="ac-meta">2012 · Compilation</div>
								<a class="ac-link" href="#" aria-label="Open album"></a>
								<button class="btn-icon btn-play ac-play" type="button" aria-label="Play album" style="background: var(--accent); color: var(--accent-ink);">@Icon("play")</button>
							</div>
						</div>
					</div>
				</div>
			</section>
			<section class="d-section">
				<h2>{ t.Msg("DesignTrackRows") }</h2>
				<p class="d-note">TrackRow: .tracklist + .tr (+ .play-hover, .tr-detail-slot); detail surface: .tr-detail with .chip s</p>
				<div class="d-spec">
					<div class="d-row" style="display: block; padding: var(--space-2) var(--space-4);">
						<div class="tracklist">
							@TrackRow(t, "1", "Track title", "5:44", "", "", nil)
							@TrackRow(t, "2", "別のトラック・タイトル", "3:33", "", "", nil)
							<div class="tr-detail">
								<div class="chips">
									@Chip("performance")
									@Chip("arranger")
								</div>
								<div class="detail-line">{ t.Msg("WorkLabel") } <b>{ t.Msg("SampleWork") }</b> · { t.Msg("SampleComposer") } <b>Composer name</b></div>
							</div>
							@TrackRow(t, "3", "Third track title", "2:39", "", "", nil)
						</div>
					</div>
				</div>
			</section>
			<section class="d-section">
				<h2>{ t.Msg("DesignChips") }</h2>
				<p class="d-note">.chip, .chip .dot (raw relationship types verbatim)</p>
				<div class="d-spec">
					<div class="d-row">
						<span class="d-label">.chip</span>
						@Chip("performance")
						@Chip("arranger")
						@Chip("composer")
						@Chip("producer")
						@Chip("lyricist")
					</div>
					<div class="d-row">
						<span class="d-label">group hue dot</span>
						@ChipDot("performance", "#8f6bd0")
						@ChipDot("writer", "#4e9a7a")
					</div>
				</div>
			</section>
			<section class="d-section">
				<h2>{ t.Msg("DesignEmpty") }</h2>
				<p class="d-note">.empty + .sistrum + .empty-title + .empty-body</p>
				<div class="d-spec">
					<div class="d-row" style="display: block;">
						<div class="empty">
							<svg class="sistrum" viewBox="0 0 32 48" aria-hidden="true" style="color: var(--accent);"><use href="/ui/static/mark/sistrum-line.svg#mark"></use></svg>
							<div class="empty-title">Nothing here yet</div>
							<div class="empty-body">Empty states speak in the serif voice, with the mark above.</div>
						</div>
					</div>
				</div>
			</section>
			<section class="d-section">
				<h2>{ t.Msg("DesignIcons") }</h2>
				<p class="d-note">static/icons/&lt;name&gt;.svg, referenced via &lt;use&gt; (12 icon set)</p>
				<div class="d-icon-grid">
					<div class="d-icon-cell">@Icon("search")<span class="d-label">search</span></div>
					<div class="d-icon-cell">@Icon("play")<span class="d-label">play</span></div>
					<div class="d-icon-cell">@Icon("pause")<span class="d-label">pause</span></div>
					<div class="d-icon-cell">@Icon("prev")<span class="d-label">prev</span></div>
					<div class="d-icon-cell">@Icon("next")<span class="d-label">next</span></div>
					<div class="d-icon-cell">@Icon("heart")<span class="d-label">heart</span></div>
					<div class="d-icon-cell">@Icon("heart-filled")<span class="d-label">heart-filled</span></div>
					<div class="d-icon-cell">@Icon("info")<span class="d-label">info</span></div>
					<div class="d-icon-cell">@Icon("trash")<span class="d-label">trash</span></div>
					<div class="d-icon-cell">@Icon("home")<span class="d-label">home</span></div>
					<div class="d-icon-cell">@Icon("library")<span class="d-label">library</span></div>
					<div class="d-icon-cell">@Icon("settings")<span class="d-label">settings</span></div>
					<div class="d-icon-cell">@Icon("close")<span class="d-label">close</span></div>
				</div>
			</section>
			<section class="d-section">
				<h2>{ t.Msg("DesignFeedback") }</h2>
				<p class="d-note">.skeleton, .toast</p>
				<div class="d-spec">
					<div class="d-row">
						<span class="d-label">.skeleton</span>
						<div style="flex: 1; display: grid; gap: var(--space-2);">
							<div class="skeleton" style="height: 14px; width: 70%;"></div>
							<div class="skeleton" style="height: 14px; width: 45%;"></div>
						</div>
					</div>
					<div class="d-row">
						<span class="d-label">.toast</span>
						<div class="toast">Transient confirmation message.</div>
					</div>
				</div>
			</section>
		</div>
		<script>
			// Fixture affordance: theme switch (not a product component).
			document.addEventListener('change', function (e) {
				if (e.target.name === 'd-theme') document.body.dataset.theme = e.target.value;
			});
		</script>
	}
}
