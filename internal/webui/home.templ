package webui

templ HomePage(t *T, stats StatsVM) {
	@Layout(t, t.Msg("Library"), "library") {
		<h1 class="page-title">{ t.Msg("Library") }</h1>
		<p class="muted">
			{ t.Plural("StatsFiles", stats.Files) } · { t.Plural("StatsArtists", stats.Artists) } · { t.Plural("StatsAlbums", stats.ReleaseGroups) } · { t.Plural("StatsRecordings", stats.Recordings) }
		</p>
		<input
			type="search"
			name="q"
			placeholder={ t.Msg("SearchPlaceholder") }
			autofocus
			hx-get="/ui/search/results"
			hx-trigger="input changed delay:300ms, search"
			hx-target="#search-results"
		/>
		<div id="search-results"></div>
	}
}
