// The web UI: server-rendered pages (templ) with htmx for partial
// updates. Design of record: internal/webui/DESIGN.md (Dendera).
package webui

templ Layout(t *T, title string, active string) {
	<!DOCTYPE html>
	<html lang={ t.Lang.String() }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · ihy</title>
			<link rel="icon" type="image/svg+xml" href="/ui/static/mark/sistrum-solid.svg"/>
			<script src="/ui/static/htmx.min.js"></script>
			<link rel="stylesheet" href="/ui/static/app.css"/>
			<link rel="stylesheet" href="/ui/static/fonts/fonts.css"/>
			<link rel="stylesheet" href="/ui/static/tokens.css"/>
			<link rel="stylesheet" href="/ui/static/components.css"/>
		</head>
		<body data-theme="lapis" class={ templ.KV("with-shell", active != "") } hx-boost="true">
			if active != "" {
				@Nav(t, active)
				<script>
					// The nav is preserved across boosted swaps
					// (hx-preserve), so its server-rendered active state
					// never changes: keep it in step with the URL. The
					// rule is structural (it survives new items): the
					// item whose href prefixes the current path wins;
					// "/" is the fallback, so entity pages keep Library
					// highlighted. The body's innerHTML is swapped on
					// every navigation, so the guard keeps one set of
					// listeners.
					(function () {
						if (window.__ihyNavSync) return;
						window.__ihyNavSync = true;
						function sync() {
							var path = location.pathname, best = null, fallback = null;
							document.querySelectorAll('.nav-item').forEach(function (a) {
								var href = a.getAttribute('href');
								if (href === '/') fallback = a;
								if (href !== '/' && (path === href || path.indexOf(href + '/') === 0)) best = a;
							});
							var winner = best || fallback;
							document.querySelectorAll('.nav-item').forEach(function (a) {
								a.classList.toggle('is-active', a === winner);
							});
						}
						document.body.addEventListener('htmx:afterSettle', sync);
						document.body.addEventListener('htmx:historyRestore', sync);
					})();
				</script>
			}
			<main id="content">
				{ children... }
			</main>
			if t.Dev {
				<script>
					// Dev hot reload (make dev-ui): swap stylesheets on
					// asset changes; full reload when the dev server
					// restarted (connection dropped). The window guard
					// keeps one EventSource across hx-boost swaps.
					(function () {
						if (window.__ihyHotReload) return;
						window.__ihyHotReload = true;
						var es = new EventSource('/ui/dev/refresh');
						var down = false;
						es.addEventListener('change', function () {
							document.querySelectorAll('link[rel="stylesheet"]').forEach(function (l) {
								l.href = l.href.split('?')[0] + '?t=' + Date.now();
							});
						});
						es.onerror = function () { down = true; };
						es.onopen = function () { if (down) location.reload(); };
					})();
				</script>
			}
		</body>
	</html>
}
