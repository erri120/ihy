package webui

templ ArtistPage(t *T, a ArtistVM) {
	@Layout(t, a.Name) {
		<header class="page-head">
			<h1>{ a.Name }</h1>
			<form method="post" action="/logout" class="logout">
				<button type="submit">{ t.Msg("LogOut") }</button>
			</form>
		</header>
		if a.Canonical != a.Name {
			<p class="muted">{ t.Msg("Canonical") } { a.Canonical }</p>
		}
		if a.Meta != "" {
			<p class="muted">{ a.Meta }</p>
		}
		<h2>{ t.Msg("Albums") }</h2>
		if len(a.Albums) == 0 {
			<p class="muted">{ t.Msg("NoAlbums") }</p>
		} else {
			<ul class="results">
				for _, al := range a.Albums {
					<li>
						<a href={ templ.URL(al.Href()) }>{ al.Name }</a>
						if al.FirstReleaseDate != "" {
							<span class="muted">{ " " }{ al.FirstReleaseDate }</span>
						}
						if al.Relationship == "featured" {
							<span class="badge">{ t.Plural("FeaturedOnTracks", al.FeaturedTracks) }</span>
						}
					</li>
				}
			</ul>
		}
	}
}
