package webui

templ ComingSoonPage(t *T, title string) {
	@Layout(t, title) {
		<header class="page-head">
			<h1>{ title }</h1>
			<form method="post" action="/logout" class="logout">
				<button type="submit">{ t.Msg("LogOut") }</button>
			</form>
		</header>
		<p class="muted">{ t.Msg("ComingSoon") }</p>
	}
}
