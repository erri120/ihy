// Design system atoms: the templ components behind the Dendera
// component library (DESIGN.md §5). Pages compose these; the design
// page (/ui/design) catalogs them.
package webui

// Icon renders a system icon from the 13-icon set (static/icons/).
templ Icon(name string) {
	<svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><use href={ templ.URL("/ui/static/icons/" + name + ".svg#icon") }></use></svg>
}

// Chip renders a neutral credit/tag pill; text is the raw upstream
// relationship type, verbatim.
templ Chip(text string) {
	<span class="chip">{ text }</span>
}

// ChipDot renders a chip with the 8px group-hue dot (credit and graph
// surfaces only, where a legend exists).
templ ChipDot(text, hue string) {
	<span class="chip"><span class="dot" style={ "background: " + hue }></span>{ text }</span>
}

// Cover renders a cover in one of the size classes; an empty src
// renders the designed gray placeholder.
templ Cover(src, alt, size string) {
	if src == "" {
		<div class={ "cover cover-empty " + size } title={ alt }></div>
	} else {
		<img class={ "cover " + size } src={ src } alt={ alt }/>
	}
}

// NavItem is one shell navigation destination. Items are listening
// surfaces, never entity types; Playlists and Settings join when their
// pages land (design-plan phases 7/8): the nav never links a dead
// destination.
type NavItem struct {
	ID, Label, Href, Icon string
}

// navItems is the shell's item list. Entity pages (artist, release,
// recording) highlight "library": they are library content.
func navItems(t *T) []NavItem {
	return []NavItem{
		{ID: "library", Label: t.Msg("Library"), Href: "/", Icon: "library"},
		{ID: "search", Label: t.Msg("Search"), Href: "/ui/search", Icon: "search"},
	}
}

// Nav is the app shell: brand wordmark, item list, logout. One markup,
// two shells: CSS renders it as a sticky sidebar >= 600px and a fixed
// bottom bar below (no per-device markup). Boosted navigation swaps
// the response body (htmx boost semantics), so the nav carries
// hx-preserve with a stable id: htmx keeps the live nav element and
// the layout's sync script keeps its active state in step with the
// URL. Auth forms opt out of boost: a post-logout redirect must be a
// real navigation.
templ Nav(t *T, active string) {
	<nav id="shell-nav" class="shell-nav" hx-preserve="true" aria-label={ t.Msg("NavLabel") }>
		<a class="shell-brand" href="/">ihy</a>
		<ul class="nav-items">
			for _, item := range navItems(t) {
				<li>
					<a class={ "nav-item", templ.KV("is-active", item.ID == active) } href={ templ.URL(item.Href) }>
						@Icon(item.Icon)
						<span>{ item.Label }</span>
					</a>
				</li>
			}
		</ul>
		<div class="shell-logout">
			<form method="post" action="/logout" hx-boost="false">
				<button class="btn btn-ghost" type="submit">{ t.Msg("LogOut") }</button>
			</form>
		</div>
	</nav>
}

// Button renders a labelled action. Variant: "" (primary gold fill),
// "ghost", "danger". Everything else (disabled, title, hx wiring)
// rides in attrs so pages never hand-roll class strings.
templ Button(t *T, label, variant string, attrs templ.Attributes) {
	<button
		class={ "btn", templ.KV("btn-"+variant, variant != "") }
		type="button"
		{ attrs... }
	>{ label }</button>
}

// IconButton renders an icon-only action; active carries the .is-active
// state (gold icon). Icons come from the system set by name.
templ IconButton(t *T, icon string, active bool, attrs templ.Attributes) {
	<button
		class={ "btn-icon", templ.KV("is-active", active) }
		type="button"
		{ attrs... }
	>@Icon(icon)</button>
}

// TabsNav renders the tab navigation: one markup, hx-wired against
// targetID's panel (outerHTML) with full-URL fallback for deep links.
// An empty targetID renders a static specimen (the catalog) with no
// behavior; an empty Fragment renders a plain link.
templ TabsNav(t *T, tabs []TabVM, label, targetID string) {
	<nav class="tabs" aria-label={ label }>
		for _, tb := range tabs {
			if targetID == "" {
				<a class={ "tab", templ.KV("is-active", tb.Active) } href={ templ.URL(tb.URL) }>{ tb.Label }</a>
			} else {
				<a
					class={ "tab", templ.KV("is-active", tb.Active) }
					href={ templ.URL(tb.URL) }
					hx-get={ templ.URL(tb.Fragment) }
					hx-target={ "#" + targetID }
					hx-swap="outerHTML"
				>{ tb.Label }</a>
			}
		}
	</nav>
}

// Empty renders the designed empty state: the sistrum mark above a
// serif title (optional) and a muted body line.
templ Empty(t *T, title, body string) {
	<div class="empty">
		<svg class="sistrum" viewBox="0 0 32 48" aria-hidden="true" style="color: var(--accent);"><use href="/ui/static/mark/sistrum-line.svg#mark"></use></svg>
		if title != "" {
			<div class="empty-title">{ title }</div>
		}
		<div class="empty-body">{ body }</div>
	</div>
}

// AlbumCard is the browse-grid unit for albums: cover, title, optional
// artist line (omitted where the page context names the artist), meta
// line, a link that stretches over the tile, and the gold play circle
// on the cover's lower right (revealed on hover and focus, always
// visible where hover is absent). The primary click is a play intent,
// like every listening row; an empty Mbid renders a static specimen.
templ AlbumCard(t *T, vm AlbumVM, artist string) {
	if vm.Mbid == "" {
		<div class="album-card">
			@Cover("", vm.Name, "")
			<div class="ac-title">{ vm.Name }</div>
			if artist != "" {
				<div class="ac-artist">{ artist }</div>
			}
			<div class="ac-meta">{ vm.FirstReleaseDate } · { vm.Kind(t) }</div>
		</div>
	} else {
		<div class="album-card">
			@Cover("", vm.Name, "")
			<div class="ac-title">{ vm.Name }</div>
			if artist != "" {
				<div class="ac-artist">{ artist }</div>
			}
			<div class="ac-meta">{ vm.FirstReleaseDate } · { vm.Kind(t) }</div>
			<a class="ac-link" href={ templ.URL(vm.Href()) } aria-label={ vm.Name }></a>
			<button
				class="btn-icon btn-play ac-play"
				type="button"
				aria-label={ t.Msg("Play") }
				hx-post={ templ.URL(playAlbumURL(vm.Mbid)) }
				hx-swap="none"
			>@Icon("play")</button>
		</div>
	}
}

// TrackDetail is the detail surface beneath a listening row: credit
// roles verbatim as chips, the work line beneath, or the no-details
// line when neither exists.
templ TrackDetail(t *T, roles []string, work string) {
	<div class="tr-detail">
		if len(roles) > 0 {
			<div class="chips">
				for _, r := range roles {
					@Chip(r)
				}
			</div>
		}
		if work != "" {
			<div class="detail-line">{ t.Msg("WorkLabel") } <b>{ work }</b></div>
		}
		if len(roles) == 0 && work == "" {
			<div class="detail-line">{ t.Msg("NoDetails") }</div>
		}
	</div>
}

// TrackRow is the listening row: number, title, duration, play
// affordance on hover; the row's primary click posts a play intent
// (hx-swap none: playback has no document payload), the info
// affordance loads the credit detail into the slot beneath the row.
// Empty URLs render a static specimen (the catalog) with no behavior.
templ TrackRow(t *T, no, title, dur, playURL, detailURL string, detail templ.Component) {
	if playURL == "" {
		<div class="tr">
			<span class="no">{ no }</span>
			<span class="t">{ title }</span>
			<span class="dur">{ dur }</span>
		</div>
	} else {
		<div class="tr" role="button" tabindex="0" title={ t.Msg("Play") } hx-post={ templ.URL(playURL) } hx-swap="none" hx-trigger="click, keydown[key=='Enter'], keydown[code=='Space']">
			<span class="no">{ no }</span>
			<span class="t">{ title }</span>
			<span class="dur">{ dur }</span>
			<button class="btn-icon play-hover" type="button" aria-label={ t.Msg("Play") } hx-post={ templ.URL(playURL) } hx-swap="none">@Icon("play")</button>
			if detailURL != "" {
				<button class="btn-icon" type="button" aria-label={ t.Msg("Details") } hx-get={ templ.URL(detailURL) } hx-target="next .tr-detail-slot" hx-swap="innerHTML">@Icon("info")</button>
			}
		</div>
	}
	if detail != nil {
		@detail
	} else if detailURL != "" {
		<div class="tr-detail-slot"></div>
	}
}
